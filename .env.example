# Copy to .env and fill in. Never commit .env.

# Path to a .potx / .pptx template. Empty = python-pptx built-in template.
SLIDEGEN_TEMPLATE=

# mock | lmstudio | ford
LLM_PROVIDER=mock
LLM_MODEL=

# LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# FordLLM gateways
FORD_BASE_URL=
FORD_BASE_URL_SECRET=
# secret | standard   (secret is the default; briefs contain unannounced product information)
FORD_TIER=secret
FORDLLM_CLIENT_ID=
FORDLLM_CLIENT_SECRET=
FORDLLM_TENANT_ID=
# Defaults to {client_id}/.default
FORDLLM_SCOPE=
# Override only for a non-public cloud
FORDLLM_AUTHORITY=

# Generation
CANDIDATE_COUNT=3
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# Required on the Ford network
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
